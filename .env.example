# Copy to .env and fill in. Without a key the app runs in demo mode
# (canned story content so you can preview the UI).
# Production refuses to start in demo mode unless this is explicitly enabled
# for a non-charging preview deployment.
# ALLOW_DEMO_IN_PRODUCTION=0
ANTHROPIC_API_KEY=sk-ant-...

# Accounts & cloud library (optional) — create a project at supabase.com,
# run supabase/schema.sql in its SQL editor, then fill these in from
# Project Settings → API. Without them the library is device-local only.
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_ANON_KEY=eyJ...
# Service-role key (server-only secret!) moves share storage into Supabase
# and enables server-owned story sessions, distributed limits, and operations:
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Payments (optional) — one free story, then story packs via Stripe. Requires the
# Supabase service-role key above. From dashboard.stripe.com:
#   STRIPE_SECRET_KEY   → Developers → API keys → restricted key (rk_live_… / rk_test_…)
#   STRIPE_WEBHOOK_SECRET → Developers → Webhooks → your endpoint's signing secret (whsec_…)
# The webhook endpoint URL is  https://YOUR-DOMAIN/api/stripe/webhook
# and must subscribe to checkout.session.completed,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed,
# and charge.refunded (for automatic full-refund credit reversal).
# STRIPE_SECRET_KEY=rk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CURRENCY=usd
# PUBLIC_APP_URL=https://larkspin.com
#
# Credits are deliberately opt-in. The server refuses to start with credits
# enabled unless Checkout is fully configured (or an intentional pilot override
# is set). Prefer a restricted Stripe key (rk_...) with only required access.
# STORY_CREDITS_ENABLED=1
# ALLOW_FREE_ONLY_CREDITS=0
#
# Temporary launch testing: exposes a clearly labeled sandbox checkout and
# balance counter without enforcing credits. It refuses to start with a live
# Stripe key or when STORY_CREDITS_ENABLED=1.
# STRIPE_SANDBOX_TESTING=1
# Sandbox operations only: set briefly to one exact signed event id to prove
# Stripe receives a 503 and succeeds after the variable is removed and retried.
# STRIPE_WEBHOOK_FAIL_EVENT_ID=

# Staff accounts (optional) — unlimited stories, never charged, and the only
# accounts that reach Story Studio and the publisher's ledger.
#
# Bind staff to Supabase user ids, NOT email addresses. Copy the id from
# Supabase → Authentication → Users. An email can be registered by anyone:
# with "Confirm email" off every signup is auto-confirmed. ADMIN_EMAILS is
# ignored and must be removed for preflight to pass. Verify the account owner
# before adding their immutable id.
# ADMIN_USER_IDS=00000000-0000-4000-8000-000000000000,...

# Anonymous teaser (optional) — one free live first chapter for signed-out
# visitors, before the sign-up wall. Off unless explicitly enabled; it spends
# real API budget on unauthenticated requests. Apply
# supabase/migrations/20260807050000_teaser_adoption.sql BEFORE enabling, or a
# reader loses the chapter we paid for. Full rollout: docs/TEASER_ROLLOUT.md
# TEASER_ENABLED=1
# Signs teaser chapters so they can be redeemed after sign-in. Unset, the
# server mints a random secret per boot and every redeploy voids outstanding
# teasers against their TTL. Set it wherever teasers are enabled.
# TEASER_SECRET=replace-with-a-long-random-value
# TEASER_PER_VISITOR_PER_DAY=1
# Backstop for the clearable per-visitor id. Keep it above the per-visitor
# limit: offices, universities and carrier NAT share one address.
# TEASER_PER_IP_PER_DAY=5
# Global daily ceiling, and the cap on worst-case teaser spend.
# TEASER_DAILY_LIMIT=200
# How long a saved teaser stays redeemable (default 7 days).
# TEASER_TTL_SECONDS=604800

# Optional overrides
# PORT=3000
# STORY_MODEL=claude-opus-4-8
# TARGET_CHAPTERS=10
# RATE_LIMIT_PER_HOUR=40
# DEMO_MODE=1
# REQUIRE_AUTH_FOR_LIVE=1
# AI_COVERS=0
# REPORT_HASH_SALT=replace-with-a-long-random-value
# Model prices the publisher's ledger uses to cost every page, in dollars per
# million tokens. These are the published Claude Opus 4.8 rates. Left unset
# they default to 0, and every story silently reports as costing nothing —
# worse than an approximate number. Re-check them whenever STORY_MODEL changes.
MODEL_INPUT_USD_PER_MILLION=5
MODEL_OUTPUT_USD_PER_MILLION=25

# Operations thresholds. `npm run ops:check` exits non-zero for critical
# conditions and POSTs its JSON report to a private alerting webhook.
# Without a destination a credit-ledger mismatch — which also starts answering
# readers 503 — reaches nothing but the deploy logs, so preflight warns when
# this is unset and fails on it once credits are live. Must be https.
# OPS_ALERT_WEBHOOK_URL=https://YOUR-PRIVATE-ALERT-ENDPOINT
# GENERATION_FAILURE_ALERT_RATE=0.10
# DAILY_MODEL_SPEND_ALERT_USD=25
# DAILY_REFUND_ALERT_COUNT=3
# REPORT_BACKLOG_ALERT_COUNT=5
# DAILY_COVER_ALERT_COUNT=20

# Optional Healthchecks heartbeat for successful and failed ops:check runs.
# Use the base ping URL here and its /fail URL as OPS_ALERT_WEBHOOK_URL.
# Set the check period to match Railway, plus a 10-minute grace window.
# OPS_HEALTHCHECK_URL=https://hc-ping.com/YOUR-CHECK-UUID
